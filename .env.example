NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
# Canonical site origin. Local: http://localhost:3000. Vercel production: https://profili.fyi
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# App + Drizzle: transaction-mode pooler (IPv4). Disable prepared statements.
DATABASE_URL="postgresql://postgres.dbavybpccczzydwiwtck:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:6543/postgres"
# Migrations: session-mode pooler if 6543 fails on DDL.
# DATABASE_URL_MIGRATE="postgresql://postgres.dbavybpccczzydwiwtck:[YOUR-PASSWORD]@aws-1-eu-west-3.pooler.supabase.com:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
GEMINI_API_KEY=your_gemini_api_key
# Optional. Tries gemini-3.8-flash, then 3.7-flash, then 3.1-flash-lite.
# GEMINI_PARSE_MODEL=gemini-3.8-flash
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
# Inngest: keep `pnpm dev` and `pnpm inngest:dev` running together.
# Local SDK talks to http://localhost:8288. Do not set cloud keys while using the Dev Server.
# INNGEST_DEV=1
# Production (Vercel + Inngest Cloud):
# INNGEST_EVENT_KEY=your_inngest_event_key
# INNGEST_SIGNING_KEY=your_inngest_signing_key
